{
  "name": "@airspeed-co/avionics",
  "version": "0.2.0",
  "description": "Shared structural core for Airspeed Co. websites: form blocks, validation, head baking, and the Cloudflare Worker contact handler. Ships raw Preact + TypeScript source; the consuming site's Vite compiles it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airspeed-co/avionics.git"
  },
  "files": [
    "src",
    "tsconfig.site.json",
    "tsconfig.scripts.json",
    "tsconfig.site-worker.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./blocks": "./src/blocks/index.ts",
    "./domain": "./src/domain/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./worker": "./src/worker/index.ts",
    "./airframe": "./src/airframe/index.ts",
    "./images": "./src/images/index.mjs",
    "./config": "./src/config/index.mjs",
    "./vite": "./src/vite/index.mjs",
    "./tsconfig.site.json": "./tsconfig.site.json",
    "./tsconfig.scripts.json": "./tsconfig.scripts.json",
    "./tsconfig.worker.json": "./tsconfig.site-worker.json"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "spellcheck": "cspell \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "peerDependencies": {
    "preact": "^10.29.0",
    "preact-iso": "^2.12.0",
    "sharp": "^0.35.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "cspell": "^10.0.1",
    "preact": "^10.29.7",
    "preact-iso": "^2.12.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@preact/preset-vite": "^2.10.6",
    "browserslist": "^4.28.8",
    "lightningcss": "^1.33.0"
  }
}
