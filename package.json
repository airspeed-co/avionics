{
  "name": "@airspeed-co/avionics",
  "version": "0.1.0",
  "description": "Shared structural core for Airspeed Co. websites: form blocks, validation, head baking, and the Cloudflare Worker contact handler. Ships raw Preact + TypeScript source; the consuming site's Vite compiles it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/airspeed-co/avionics.git"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./blocks": "./src/blocks/index.ts",
    "./domain": "./src/domain/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./utils": "./src/utils/index.ts",
    "./worker": "./src/worker/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "spellcheck": "cspell \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "peerDependencies": {
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "cspell": "^10.0.1",
    "preact": "^10.29.7",
    "typescript": "^6.0.3"
  }
}
